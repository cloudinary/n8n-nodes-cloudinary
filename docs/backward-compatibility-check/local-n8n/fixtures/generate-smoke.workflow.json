{
	"id": "cldGenSmokeTest1",
	"name": "Cloudinary Generate smoke",
	"active": false,
	"settings": { "executionOrder": "v1" },
	"connections": {
		"Start": {
			"main": [
				[
					{ "node": "Text to Image (managed)", "type": "main", "index": 0 },
					{ "node": "Text to Image (async)", "type": "main", "index": 0 },
					{ "node": "Error: invalid task", "type": "main", "index": 0 },
					{ "node": "Error: missing reference asset", "type": "main", "index": 0 }
				]
			]
		},
		"Text to Image (managed)": {
			"main": [
				[
					{ "node": "Transform: Optimize generated", "type": "main", "index": 0 },
					{ "node": "Image to Image (from generated)", "type": "main", "index": 0 }
				]
			]
		},
		"Text to Image (async)": {
			"main": [[{ "node": "Wait", "type": "main", "index": 0 }]]
		},
		"Wait": {
			"main": [[{ "node": "Get Generation Task", "type": "main", "index": 0 }]]
		}
	},
	"nodes": [
		{
			"id": "a0000000-0000-4000-8000-000000000001",
			"name": "Start",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [0, 300],
			"parameters": {}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000002",
			"name": "Text to Image (managed)",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [260, 100],
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "generate",
				"operation": "textToImage",
				"prompt": "A tiny robot watering a bonsai tree, soft studio light",
				"modelSelection": "family",
				"modelFamily": "flux",
				"modelTier": "standard",
				"imageSize": "aspectRatio",
				"imageSizeAspectRatio": "1:1",
				"imageSizeResolution": "0.5K",
				"generateOptions": {
					"public_id": "={{ 'n8n-smoke/editor-' + $now.toMillis() }}",
					"seed": 7
				}
			}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000003",
			"name": "Transform: Optimize generated",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [520, 0],
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "transform",
				"operation": "optimizeImage",
				"transformPublicId": "={{ $json.public_id }}"
			}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000004",
			"name": "Image to Image (from generated)",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [520, 200],
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "generate",
				"operation": "imageToImage",
				"prompt": "Restyle [1] as a pencil sketch, keep the composition",
				"reference_images": {
					"reference_image": [{ "source_type": "url", "url": "={{ $json.secure_url }}" }]
				},
				"modelSelection": "family",
				"modelFamily": "flux",
				"modelTier": "standard",
				"generateOptions": { "target_type": "temporary" }
			}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000005",
			"name": "Text to Image (async)",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [260, 400],
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "generate",
				"operation": "textToImage",
				"prompt": "A paper boat on a puddle after rain",
				"modelSelection": "family",
				"modelFamily": "flux",
				"modelTier": "standard",
				"generateOptions": { "async": true, "target_type": "temporary" }
			}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000006",
			"name": "Wait",
			"type": "n8n-nodes-base.wait",
			"typeVersion": 1.1,
			"position": [520, 400],
			"webhookId": "b0000000-0000-4000-8000-000000000006",
			"parameters": { "resume": "timeInterval", "amount": 20, "unit": "seconds" }
		},
		{
			"id": "a0000000-0000-4000-8000-000000000007",
			"name": "Get Generation Task",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [780, 400],
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "generate",
				"operation": "getTask",
				"task_id": "={{ $json.task_id }}"
			}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000008",
			"name": "Error: invalid task",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [260, 600],
			"onError": "continueRegularOutput",
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "generate",
				"operation": "getTask",
				"task_id": "abcdef0123456789"
			}
		},
		{
			"id": "a0000000-0000-4000-8000-000000000009",
			"name": "Error: missing reference asset",
			"type": "n8n-nodes-cloudinary.cloudinary",
			"typeVersion": 2,
			"position": [260, 800],
			"onError": "continueRegularOutput",
			"credentials": { "cloudinaryApi": { "id": "cldSmokeCred0001", "name": "Cloudinary smoke" } },
			"parameters": {
				"resource": "generate",
				"operation": "imageToImage",
				"prompt": "x",
				"reference_images": {
					"reference_image": [{ "source_type": "managed_asset", "asset_id": "00000000000000000000000000000000" }]
				},
				"generateOptions": { "target_type": "temporary" }
			}
		}
	]
}
